# Web app env. Vite reads VITE_*-prefixed vars at build time and
# inlines them into the bundle, so values here are *not* secret —
# they ship to every browser. Copy to `.env` (or `.env.local`) and
# adjust as needed.

# Idle-logout timeout in minutes. After this much continuous user
# inactivity the SPA logs the user out and redirects to /login.
# Default: 5. Set to e.g. 30 for a more relaxed session, 1 for
# aggressive logout on shared workstations.
VITE_IDLE_TIMEOUT_MINUTES=5

# Origin of the API server for `pnpm dev`. Only consulted by the
# vite dev-server proxy; production builds talk to whatever origin
# the SPA is served from.
# VITE_API_URL=http://localhost:4000
