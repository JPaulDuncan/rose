# Copy to .env and fill in. The dev defaults below work with the bundled compose stack.
NODE_ENV=development
PORT=4000

# MongoDB and Redis (compose service names)
MONGO_URI=mongodb://mongo:27017/rose
REDIS_URL=redis://redis:6379

# Ollama. The compose-network URL stays on the in-container port (11434).
# When running the api/worker on the host (e.g. `pnpm dev`) and pointing at
# the compose-managed Ollama, use http://localhost:11444 instead.
OLLAMA_URL=http://ollama:11434
DEFAULT_GENERATION_MODEL=llama3.1:8b-instruct
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Auth
JWT_SECRET=change-me-please-32-chars-minimum
JWT_REFRESH_SECRET=change-me-too-32-chars-minimum
ENCRYPTION_KEY=32-char-secret-for-source-config

# CORS / cookies
WEB_ORIGIN=http://localhost:5173

# Registration
ENABLE_REGISTRATION=true

# Gmail OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback
